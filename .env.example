# ========================================
# CAKE POS API CREDENTIALS
# Get these from CAKE Settings → API/Integrations
# ========================================
CAKE_API_KEY=your-cake-api-key-here
CAKE_API_URL=https://api.trycake.com
CAKE_LOCATION_ID=your-location-id-here

# ========================================
# GOOGLE CLOUD SERVICE ACCOUNT
# Download JSON key from Google Cloud Console
# → Service Accounts → Create Key → JSON
# → Copy entire JSON and paste here (single line)
# ========================================
GOOGLE_CREDENTIALS={"type":"service_account","project_id":"..."}

# ========================================
# GOOGLE SHEETS
# Share your Google Sheet with the service account email
# (found in the GOOGLE_CREDENTIALS JSON)
# ========================================
GOOGLE_SHEET_ID=your-sheet-id-from-url

# ========================================
# WEBHOOK SECURITY
# Random secret - CAKE will send this with each webhook
# ========================================
WEBHOOK_SECRET=your-random-webhook-secret-here

# ========================================
# SERVER
# ========================================
PORT=3000
NODE_ENV=production
