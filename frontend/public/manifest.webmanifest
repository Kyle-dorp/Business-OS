{
  "name": "Business-EOS",
  "short_name": "Business-EOS",
  "description": "One operating system for the whole shop — scheduling, stock, books, customers, invoicing.",
  "id": "/",
  "start_url": "/?source=installed",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#0E0B0C",
  "theme_color": "#0E0B0C",
  "categories": ["business", "productivity", "finance"],
  "dir": "ltr",
  "lang": "en",
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Today's schedule",
      "short_name": "Schedule",
      "description": "Who is on right now",
      "url": "/scheduling?source=shortcut"
    },
    {
      "name": "Ask the assistant",
      "short_name": "Ask",
      "description": "Question your business data",
      "url": "/assistant?source=shortcut"
    },
    {
      "name": "New invoice",
      "short_name": "Invoice",
      "description": "Bill a customer",
      "url": "/invoicing/new?source=shortcut"
    }
  ]
}
